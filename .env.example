# Cardano preprod
BLOCKFROST_PROJECT_ID=
FACILITATOR_URL=https://x402.preprod.dev.ecosyseng.cf-deployments.org

# Wallet mnemonics (preprod only)
ATLAS_MNEMONIC=
BUYER_MNEMONIC=
INVESTOR_MNEMONIC=

# Base Sepolia (CRE simulation broadcasts)
CRE_ETH_PRIVATE_KEY=

# Masumi Payment Service
MPS_URL=http://localhost:3012
MPS_ADMIN_KEY=
MPS_ENCRYPTION_KEY=

# LLM auditors (payment gate)
LLM_AUDITOR_A_KEY=
LLM_AUDITOR_B_KEY=

# Masumi selling wallet, exported from the payment service admin dashboard.
# Only needed by the keeper sweep, because Masumi escrow cannot pay out to a script address.
MPS_SELLING_WALLET_MNEMONIC=

# Masumi preprod deadlines in minutes from signed terms
MASUMI_PAY_BY_MINUTES=15
MASUMI_RESULT_MINUTES=25
MASUMI_UNLOCK_MINUTES=40
MASUMI_DISPUTE_MINUTES=60

# Persistent hosted funding API (server only; never NEXT_PUBLIC_)
FUNDING_API_URL=
FUNDING_API_TOKEN=
# On Atlas with a persistent /data volume: FUNDING_DATA_DIR=/data/funding
